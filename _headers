/*
  Cache-Control: public, max-age=0, must-revalidate

/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400

/*.ico
  ! Cache-Control
  Cache-Control: public, max-age=86400

/*.png
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Internal working notes. Unlinked, but directly fetchable because the repo root
# is the deploy root -- so they are told not to be indexed. This does not make
# them private; it stops them appearing in search results.
/*.md
  X-Robots-Tag: noindex, nofollow

# calculators-index.json feeds the header search box, so Googlebot must still be
# able to fetch it while rendering. Blocking it in robots.txt would stop that, so
# it is served with noindex instead: fetchable, but never reported as a page.
# Search Console was listing it under "Crawled - currently not indexed".
/calculators-index.json
  X-Robots-Tag: noindex
