/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400

/*.ico
  ! Cache-Control
  Cache-Control: public, max-age=86400

/*.png
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Internal working notes. Unlinked, but directly fetchable because the repo root
# is the deploy root -- so they are told not to be indexed. This does not make
# them private; it stops them appearing in search results.
/*.md
  X-Robots-Tag: noindex, nofollow
